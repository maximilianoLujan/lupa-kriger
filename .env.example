# Fuente de datos: mock (artículos hardcodeados) | api (el ERP)
VITE_DATA_SOURCE=mock

# URL base de la API del ERP, sin barra final. Solo se usa cuando VITE_DATA_SOURCE=api.
# El ERP tiene que listar el origen de esta app en CORS_ORIGINS (p. ej. http://localhost:5173).
VITE_API_URL=http://localhost:4000
